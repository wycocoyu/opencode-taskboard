--- a/packages/app/src/composer/submit.test.ts
+++ b/packages/app/src/composer/submit.test.ts
@@ -642,4 +642,50 @@ describe("Composer submission", () => {
     expect(calls).toEqual([])
     expect(state.current().some((part) => part.type === "image")).toBe(true)
   })
+
+  test("switches session agent when a primary agent is @-mentioned (case-insensitive) and excludes primary agents from subagent list", async () => {
+    const state = createMemoryComposerState().capture()
+    const text = "@Plan @reviewer inspect architecture"
+    state.set([
+      { type: "agent", name: "Plan", content: "@Plan", start: 0, end: 5 },
+      { type: "text", content: " ", start: 5, end: 6 },
+      { type: "agent", name: "reviewer", content: "@reviewer", start: 6, end: 15 },
+      { type: "text", content: " inspect architecture", start: 15, end: text.length },
+    ])
+
+    const calls: string[] = []
+    const admitted = Promise.withResolvers<Parameters<ComposerSession["data"]["session"]["prompt"]>[0]>()
+    let selectedAgent = "build"
+
+    const target = session({
+      calls,
+      current: () => ({ agent: "build", model: { id: "model-1", providerID: "provider-1", variant: "balanced" } }),
+      prompt: async (value) => admitted.resolve(value),
+    })
+
+    const ctl = (): ComposerControls => ({
+      agents: {
+        available: [
+          { name: "build", mode: "primary" },
+          { name: "plan", mode: "primary" },
+          { name: "reviewer", mode: "subagent" },
+        ],
+        options: ["build", "plan"],
+        current: selectedAgent,
+        visible: true,
+        select(name) {
+          if (name) selectedAgent = name
+        },
+      },
+      model: { selection, paid: true, loading: false },
+    })
+
+    await submitInput(active(state, target, ctl)).submit(new Event("submit"))
+    const request = await admitted.promise
+
+    expect(selectedAgent).toBe("plan")
+    expect(request.metadata?.agent).toBe("plan")
+    expect(calls).toContain("switch-agent")
+    expect((request.agents ?? []).map((a) => a.name)).toEqual(["reviewer"])
+  })
 })
